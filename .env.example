SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Privado: usado pelo backend para autenticar o envio SMTP.
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_app_password_sem_espacos

# Privado: destinatario que vai receber as mensagens do formulario.
# Pode ser seu e-mail pessoal sem problema, porque este valor nao vai para o frontend.
CONTACT_TO_EMAIL=seu_email@gmail.com

# Privado: remetente tecnico do envio. Se quiser, pode ser o mesmo e-mail do SMTP_USER.
CONTACT_FROM_EMAIL=seu_email@gmail.com

# Publico: este valor aparece na interface do site.
# So use seu e-mail pessoal aqui se voce quiser exibi-lo publicamente.
VITE_CONTACT_EMAIL=contato@seudominio.com

# Opcional: analytics
# VITE_ANALYTICS_ENDPOINT=https://manus-analytics.com
# VITE_ANALYTICS_WEBSITE_ID=seu-website-id